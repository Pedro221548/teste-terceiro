{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "A worker registered in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "cpf": { "type": "string" },
        "birthDate": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "docUrl": { "type": "string" },
        "rating": { "type": "number" },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "INACTIVE"] },
        "complaints": { "type": "number" },
        "lastAssignmentDate": { "type": "string" },
        "unavailableDates": { "type": "array", "items": { "type": "string" } },
        "level": { "type": "string", "enum": ["BRONZE", "PRATA", "OURO", "DIAMANTE"] },
        "attendanceRate": { "type": "number" },
        "totalEarnings": { "type": "number" },
        "faceReferenceUrl": { "type": "string" }
      },
      "required": ["firstName", "lastName", "cpf", "phone", "rating", "status"]
    },
    "Client": {
      "title": "Client",
      "description": "A partner company or unit.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "managerName": { "type": "string" },
        "location": { "type": "string" },
        "activeScales": { "type": "number" }
      },
      "required": ["name", "managerName"]
    },
    "Company": {
      "title": "Company",
      "description": "A client company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "responsibleName": { "type": "string" },
        "cnpj": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "responsibleName", "phone", "email", "createdAt"]
    },
    "Unit": {
      "title": "Unit",
      "description": "A specific unit of a company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyId": { "type": "string" },
        "name": { "type": "string" },
        "managerName": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string" },
        "favoriteEmployees": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["companyId", "name", "managerName", "location", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "A scheduled shift for an employee at a client's location.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "clientId": { "type": "string" },
        "date": { "type": "string" },
        "value": { "type": "number" },
        "status": { "type": "string", "enum": ["SCHEDULED", "IN_PROGRESS", "COMPLETED", "CANCELLED"] },
        "paymentStatus": { "type": "string", "enum": ["PENDING", "PAID", "PROCESSING"] }
      },
      "required": ["employeeId", "clientId", "date", "value", "status"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["chatId", "senderId", "text", "createdAt", "read"]
    },
    "Bulletin": {
      "title": "Bulletin",
      "description": "A public announcement or training material.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agencyId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["TRAINING", "ANNOUNCEMENT", "URGENT"] },
        "createdAt": { "type": "string" }
      },
      "required": ["agencyId", "title", "content", "type", "createdAt"]
    },
    "FeedPost": {
      "title": "FeedPost",
      "description": "A post in the feed with optional image.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agencyId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["TRAINING", "ANNOUNCEMENT", "URGENT", "RECOGNITION"] },
        "createdAt": { "type": "string" }
      },
      "required": ["agencyId", "title", "content", "type", "createdAt"]
    },
    "FeedComment": {
      "title": "FeedComment",
      "description": "A comment on a feed post.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "feedPostId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["feedPostId", "userId", "userName", "comment", "createdAt"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A monthly billing record for a company.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agencyId": { "type": "string" },
        "companyId": { "type": "string" },
        "month": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["OPEN", "PAID", "OVERDUE"] },
        "createdAt": { "type": "string" }
      },
      "required": ["agencyId", "companyId", "month", "amount", "status", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A notification for a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["ASSIGNMENT", "INFO", "TRAINING", "URGENT"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "Agency": {
      "title": "Agency",
      "description": "An agency registered on the platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "tradeName": { "type": "string" },
        "cnpj": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "BLOCKED"] },
        "plan": { "type": "string", "enum": ["STARTER", "PROFESSIONAL", "ENTERPRISE"] },
        "subscriptionStatus": { "type": "string", "enum": ["ACTIVE", "PAID", "TRIAL", "EXPIRED"] },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "cnpj", "email", "phone", "status", "plan", "subscriptionStatus", "createdAt"]
    },
    "Plan": {
      "title": "Plan",
      "description": "A subscription plan configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "maxEmployees": { "type": "number" },
        "maxCompanies": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "maxEmployees", "maxCompanies", "features", "updatedAt"]
    },
    "CheckIn": {
      "title": "CheckIn",
      "description": "A record of an employee clocking in or out.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "agencyId": { "type": "string" },
        "employeeId": { "type": "string" },
        "accessPointId": { "type": "string" },
        "location": { "type": "string" },
        "timestamp": { "type": "string" },
        "photoUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["IN", "OUT"] },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED"] },
        "diditSessionId": { "type": "string" }
      },
      "required": ["agencyId", "employeeId", "timestamp", "type", "status"]
    }
  },
  "firestore": {
    "/employees": { "schema": "Employee", "description": "Collection of employees." },
    "/clients": { "schema": "Client", "description": "Collection of partner companies." },
    "/companies": { "schema": "Company", "description": "Collection of client companies." },
    "/units": { "schema": "Unit", "description": "Collection of company units." },
    "/assignments": { "schema": "Assignment", "description": "Collection of scheduled assignments." },
    "/messages": { "schema": "Message", "description": "Collection of chat messages." },
    "/bulletins": { "schema": "Bulletin", "description": "Collection of announcements." },
    "/feedPosts": { "schema": "FeedPost", "description": "Collection of feed posts." },
    "/feedComments": { "schema": "FeedComment", "description": "Collection of feed comments." },
    "/invoices": { "schema": "Invoice", "description": "Collection of billing records." },
    "/notifications": { "schema": "Notification", "description": "Collection of user notifications." },
    "/agencies": { "schema": "Agency", "description": "Collection of agencies." },
    "/plans": { "schema": "Plan", "description": "Collection of subscription plans." },
    "/checkIns": { "schema": "CheckIn", "description": "Collection of check-in records." }
  }
}
